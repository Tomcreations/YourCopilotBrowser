<Window x:Class="YCB.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit profile"
        Width="560" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#ffffff">
    <Grid x:Name="Root" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="28,24,28,14">
            <TextBlock x:Name="TitleText" Text="Edit profile" FontSize="28" FontWeight="Normal" Foreground="#111111" Margin="0,0,0,8"/>
            <TextBlock x:Name="SubtitleText" Text="Change the name or icon. Leave the icon blank for a guest-style avatar." FontSize="14" Foreground="#111111"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Profile name" Foreground="#111111" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Height="38" Padding="12,8" Background="White" Foreground="#111111" BorderBrush="#dfe1e5" BorderThickness="1" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Icon (optional)" Foreground="#111111" FontSize="12" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconBox" Height="38" Padding="12,8" Background="White" Foreground="#111111" BorderBrush="#dfe1e5" BorderThickness="1" IsReadOnly="True" />
                    <Button x:Name="BrowseBtn" Grid.Column="1" Width="92" Height="38" Margin="8,0,0,0" Content="Browse"/>
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,16,28,24">
            <Button x:Name="CancelBtn" Width="100" Height="40" Margin="0,0,10,0" Content="Cancel"/>
            <Button x:Name="SaveBtn" Width="120" Height="40" Content="Save"/>
        </StackPanel>
    </Grid>
</Window>
