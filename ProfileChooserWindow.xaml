<Window x:Class="YCB.ProfileChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Who's using YCB?"
        Width="1020" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#f8f9fa">
    <Grid x:Name="Root" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="40,52,40,18" HorizontalAlignment="Center">
            <Border Width="70" Height="70" CornerRadius="35" Background="#5b9bf9" HorizontalAlignment="Center" Margin="0,0,0,18" >
                <Viewbox Margin="18">
                    <Path Data="M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2ZM12 4.4A7.6 7.6 0 1 1 12 19.6A7.6 7.6 0 1 1 12 4.4Z"
                          Fill="White"/>
                </Viewbox>
            </Border>
            <TextBlock x:Name="TitleText"
                       Text="Who&apos;s using YCB?"
                       FontSize="39"
                       FontWeight="Normal"
                       Foreground="#202124"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,14"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Choose a profile to keep bookmarks, extensions, passwords, cookies, and settings separate."
                       FontSize="16"
                       Foreground="#5f6368"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="700"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="40,4,40,34" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="ProfilesPanel" HorizontalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</Window>
